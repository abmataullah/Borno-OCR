PORT=3001
HOST=0.0.0.0
NODE_ENV=development

DATABASE_URL=postgresql://bornoocr:bornoocr@localhost:5432/bornoocr
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bornoocr.local

CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

OTP_EXPIRY_MINUTES=10

# Payment Gateway Keys
STRIPE_SECRET_KEY=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SSL_BASE_URL=https://sandbox.sslcommerz.com/gwprocess/v3/api.php
SSL_STORE_ID=
SSL_STORE_PASSWD=

# Worker
BACKEND_URL=http://localhost:3001
UNOSERVER_URL=http://libreoffice-worker:2003

# --- Banglai Cloud embed integration ---
# Shared HMAC secret for verifying embed tokens from Banglai Cloud.
# Must match the BORNOOCR_EMBED_SECRET env var in the Banglai Cloud Next.js app.
# Generate with: openssl rand -hex 32
BORNOOCR_EMBED_SECRET=dev-bornoocr-embed-secret-change-me

# Comma-separated list of allowed CORS origins for the Banglai Cloud app.
# In production, set this to https://banglai.cloud
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
