# DocFlow Production Environment Variables

# Database
DB_USER=docflow
DB_PASSWORD=change-me
DB_NAME=docflow

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://docflow.local

# SMTP (Postfix)
SMTP_HOST=mail.docflow.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@docflow.local

# Storage
STORAGE_TYPE=local
STORAGE_PATH=/data/uploads

# Stripe
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# bKash
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# SSL Commerz
SSL_BASE_URL=https://sandbox.sslcommerz.com/gwprocess/v3/api.php
SSL_STORE_ID=
SSL_STORE_PASSWD=

# Backup
# Configure BACKUP_DIR, UPLOADS_DIR in the backup.sh cron job
# Cron: 0 2 * * * /opt/docflow/infra/backup.sh /backups
